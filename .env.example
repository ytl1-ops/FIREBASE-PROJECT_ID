# --- Mon API (auto-hébergée, sans service d'IA externe) ---
# Jeton exigé sur les routes /api (généré automatiquement par scripts/demarrer-monmeeting)
MONMEETING_API_TOKEN=
# Origines web autorisées à appeler l'API (séparées par des virgules)
ALLOWED_ORIGINS=https://ytl1-ops.github.io
# Rédaction : modèle libre servi par Ollama (qwen2.5:7b ≈ 5 Go ; mistral-nemo plus fidèle en français, 16 Go RAM)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Transcription : service local faster-whisper + sherpa-onnx (dossier asr/)
TRANSCRIPTION_PROVIDER=local
ASR_URL=http://localhost:8000
WHISPER_MODEL=small
# Limite de requêtes coûteuses par IP et par minute
RATE_LIMIT_PER_MINUTE=20
PORT=8787

# --- Options facultatives (services externes) ---
# LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY=...   (rédaction via Claude)
# TRANSCRIPTION_PROVIDER=gladia + GLADIA_API_KEY=... (transcription via Gladia)
